#!/usr/bin/make -f

# Launchpad's PPA builders have no network access, so a pinned Rust toolchain
# and every crate Cargo.lock resolves to are vendored under packaging/vendor/
# (see packaging/vendor/README) and unpacked into build-scoped directories.
RUST_VERSION := 1.97.1
RUST_TRIPLE := x86_64-unknown-linux-gnu
VENDOR := $(CURDIR)/packaging/vendor
RUST_ROOT := $(CURDIR)/debian/.rust
PKG := $(CURDIR)/debian/clouddrop

# The CloudDrop OAuth client, compiled in so the app works out of the box.
# Not in git; packaging/set-oauth-client.sh writes it before a PPA upload.
-include packaging/oauth-client.env
export CLOUDDROP_CLIENT_ID CLOUDDROP_CLIENT_SECRET

export HOME := $(CURDIR)/debian/.home
export CARGO_HOME := $(CURDIR)/debian/.cargo
export PATH := $(RUST_ROOT)/bin:$(PATH)
export CARGO_TERM_COLOR := never
# Reproducible paths in panics/debug info.
export RUSTFLAGS := --remap-path-prefix=$(CURDIR)=/build/clouddrop

%:
	dh $@

override_dh_auto_configure:
	@[ -n "$(CLOUDDROP_CLIENT_ID)" ] || echo "note: no packaging/oauth-client.env; building without a built-in Google client"
	mkdir -p $(HOME) $(CARGO_HOME)
	cd $(VENDOR) && sha256sum -c SHA256SUMS
	if [ ! -x "$(RUST_ROOT)/bin/cargo" ]; then \
		set -e; tmp=$$(mktemp -d); \
		for c in rustc cargo rust-std; do \
			tar --no-same-owner -xJf $(VENDOR)/$$c-$(RUST_VERSION)-$(RUST_TRIPLE).tar.xz -C $$tmp; \
			$$tmp/$$c-$(RUST_VERSION)-$(RUST_TRIPLE)/install.sh \
				--prefix=$(RUST_ROOT) --disable-ldconfig --without=rust-docs >/dev/null; \
		done; \
		rm -rf $$tmp; \
	fi
	if [ ! -d "$(CURDIR)/vendor" ]; then \
		tar --no-same-owner -xJf $(VENDOR)/crates-0.1.0.tar.xz -C $(CURDIR); \
	fi
	printf '[source.crates-io]\nreplace-with = "vendored"\n[source.vendored]\ndirectory = "%s/vendor"\n[net]\noffline = true\n' \
		"$(CURDIR)" > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --release --frozen --offline -p clouddrop -p clouddrop-gui

# The end-to-end suite runs upstream; it needs dev-dependencies (a fake Drive
# server) that are not vendored.
override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/clouddrop $(PKG)/usr/bin/clouddrop
	install -Dm755 target/release/clouddrop-gui $(PKG)/usr/bin/clouddrop-gui
	install -Dm644 packaging/deb/clouddrop.service $(PKG)/usr/lib/systemd/user/clouddrop.service
	install -Dm644 nautilus/clouddrop_nautilus.py \
		$(PKG)/usr/share/nautilus-python/extensions/clouddrop_nautilus.py
	install -Dm644 data/com.dhivalabs.CloudDrop.desktop \
		$(PKG)/usr/share/applications/com.dhivalabs.CloudDrop.desktop
	install -Dm644 data/com.dhivalabs.CloudDrop.metainfo.xml \
		$(PKG)/usr/share/metainfo/com.dhivalabs.CloudDrop.metainfo.xml
	cd data/icons && find hicolor -name '*.svg' -exec install -Dm644 {} $(PKG)/usr/share/icons/{} \;

# Each user enables the service from the setup assistant once signed in; a
# globally enabled unit would start (and fail) for users who never set it up.
override_dh_installsystemduser:

override_dh_auto_clean:
	rm -rf target vendor debian/.rust debian/.cargo debian/.home
